# The agent runs on Claude Sonnet 5.5; observational memory uses Claude Haiku 5.5.
ANTHROPIC_API_KEY=

# Modal token (modal.com → Settings → API Tokens). Each user's files live
# on a Modal volume mounted into their sandboxes. Leave empty locally to run
# each sandbox as a folder under ./.sandboxes on this machine instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Platform access for observability. Injected automatically on deploy.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
MASTRA_ENVIRONMENT_ID=

# Injected when a Turso database is attached; omit locally to use ./mastra.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Placeholder sign-in: API tokens mapped to users. Each user gets their own
# threads and sandboxes. Replace with a real identity provider.
APP_USERS={"sk-alice":{"id":"alice","name":"Alice"},"sk-bob":{"id":"bob","name":"Bob"}}

# Read-only token for the gh CLI inside the sandboxes. Every user's sandboxes
# get this same token; see the README before giving it write access.
GH_TOKEN=
